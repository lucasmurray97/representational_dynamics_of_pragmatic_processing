# Copy to .env and adjust. No real credentials belong in this repo.

# Hugging Face token, only needed to download gated checkpoints (e.g. Llama).
HF_TOKEN=

# Optional: cache directory for downloaded model weights.
# HF_HOME=/path/to/hf_cache

# Where the extraction step writes per-token activations (large; not shipped).
# Defaults to ./outputs/repr_outputs
# REPR_OUTPUTS=/path/to/repr_outputs

# Where derived artifacts (curvature parquet, CKA npz, surrogates) are written.
# Defaults to ./artifacts
# ARTIFACTS=/path/to/artifacts
